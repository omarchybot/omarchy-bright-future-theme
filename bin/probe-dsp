#!/usr/bin/env bash
# Introspect Hyprland 0.56's Lua dispatch surface instead of guessing names.
# `hyprctl eval` prints only "ok" for a successful return, so error() is the
# print channel: pack what we want to read into an error message. Read-only
# apart from the deliberately-invalid no-op dispatch calls.
set -uo pipefail

probe() {
  printf '%-22s ' "$1:"
  hyprctl eval "$2" 2>&1 | head -3
}

probe "hl.dsp keys" 'local t = {}; for k in pairs(hl.dsp) do t[#t + 1] = tostring(k) end; table.sort(t); error(table.concat(t, " "))'
probe "hl.dsp.window keys" 'local t = {}; for k in pairs(hl.dsp.window) do t[#t + 1] = tostring(k) end; table.sort(t); error(table.concat(t, " "))'
probe "hl.dsp.layout keys" 'local t = {}; for k in pairs(hl.dsp.layout) do t[#t + 1] = tostring(k) end; table.sort(t); error(table.concat(t, " "))'
probe "window.move({}) says" 'hl.dsp.window.move({})'
probe "window.swap exists" 'error(type(hl.dsp.window.swap))'
probe "layout has preselect" 'error(type(hl.dsp.layout.preselect))'
