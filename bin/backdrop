#!/usr/bin/env bash
# Point the live desktop at one of this theme's backgrounds, by file name.
# Deterministic backdrop for staged shots — bg-next cycles, shots must not.
# Mirrors omarchy-theme-bg-set (symlink + shell IPC) without the cycling.
set -euo pipefail

name="${1:?usage: backdrop <background-file-name, e.g. 4-night-shift.png>}"
bg="$HOME/.local/state/omarchy/current/theme/backgrounds/$name"
[[ -f $bg ]] || { echo "no such background: $bg" >&2; exit 1; }

ln -nsf "$bg" "$HOME/.local/state/omarchy/current/background"
omarchy-shell -q background set "$bg" 2>/dev/null || true
echo "background -> $bg"
